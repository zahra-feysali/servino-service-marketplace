# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string (PostgreSQL 16+ recommended)
DATABASE_URL="postgresql://servino:servino_password@localhost:5432/servino?schema=public"

# Auth.js secret — generate one with:  npx auth secret   or   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Public base URL of the app (used by Auth.js callbacks)
NEXTAUTH_URL="http://localhost:3000"

# Private upload storage directory (outside /public). Relative paths are resolved from the project root.
UPLOAD_DIR="storage/uploads"

# Optional: override demo passwords used by `npm run db:seed` (development only)
# SEED_ADMIN_PASSWORD=""
# SEED_DEMO_PASSWORD=""
